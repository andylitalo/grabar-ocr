# Data (large files go to GCS). The tiny column-box ground truth
# (data/columns/boxes/*.json) is version-controlled as portable geometry;
# everything else under data/ (line crops, renders, predictions, column PNGs)
# stays ignored. Anchored per-level rules so the boxes negation can win over the
# blanket data/ and the global *.json rules above (last match wins, and no
# excluded parent dir).
/data/*
!/data/README.md
!/data/columns/
/data/columns/*
!/data/columns/boxes/
!/data/columns/boxes/*.json
# Blank-page markers (data/pages/blank/*.json) are human-verified ground truth, like
# the column boxes: commit them so the "this source page is blank" signal is portable
# and survives off-machine. The 646 page PDFs under data/pages/ stay ignored.
!/data/pages/
/data/pages/*
!/data/pages/blank/
!/data/pages/blank/*.json
*.pdf
*.tiff
*.tif

# Tesseract traineddata (large binary; downloaded, not source — Phase 2 hye-tesseract benchmark)
ml_vision/tessdata/

# BentoML local store
~/bentoml/

# Productionized corpus: the committed book deliverable (per-page md + per-line json
# + manifest). Text only — no images/PDFs land here. Negate the global *.json rule so
# the corpus JSON is tracked (runs/ and data/ images stay ignored above).
!/corpus/*.json
!/corpus/**/*.json

# kraken dev virtualenv & scratch line-crop outputs (dev/kraken_segment.py experiment)
dev/venv-grabar/
dev/extracted_lines/
dev/segmented_lines/
