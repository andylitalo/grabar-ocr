# Pipeline run outputs (derived artifacts; per-line JSON + merged docs + scorecards)
runs/

# Data (large files go to GCS). The tiny column-box ground truth
# (data/columns/boxes/*.json) is version-controlled as portable geometry;
# everything else under data/ (line crops, renders, predictions, column PNGs)
# stays ignored. Anchored per-level rules so the boxes negation can win over the
# blanket data/ and the global *.json rules above (last match wins, and no
# excluded parent dir).
/data/*
!/data/README.md
!/data/columns/
/data/columns/*
!/data/columns/boxes/
!/data/columns/boxes/*.json
# Blank-page markers (data/pages/blank/*.json) are human-verified ground truth, like
# the column boxes: commit them so the "this source page is blank" signal is portable
# and survives off-machine. The 646 page PDFs under data/pages/ stay ignored.
!/data/pages/
/data/pages/*
!/data/pages/blank/
!/data/pages/blank/*.json
# Phase 9 verified line geometry (data/verified_lines/page_<N>.json): materialized from
# paddle-filled + human review ops, committed so later stages read stable line ids.
!/data/verified_lines/
!/data/verified_lines/*.json
# Phase 10 transcriptions keyed by verified line id (data/transcriptions/<task>/...).
!/data/transcriptions/
/data/transcriptions/*
!/data/transcriptions/*/
!/data/transcriptions/*/*.json
# Phase 11 OCR predictions per engine, keyed by verified line id.
!/data/ocr_predictions/
!/data/ocr_predictions/*.json
*.pdf
*.tiff
*.tif

# Tesseract traineddata (large binary; downloaded, not source — Phase 2 hye-tesseract benchmark)
ml_vision/tessdata/

# Tesseract fine-tuning scratch + tesstrain clone + staged GT (Phase 2b; large/derived)
ml_vision/tessdata_ft/

# BentoML local store
~/bentoml/

# Productionized corpus: the committed book deliverable (per-page md + per-line json
# + manifest). Text only — no images/PDFs land here. Negate the global *.json rule so
# the corpus JSON is tracked (runs/ and data/ images stay ignored above).
!/corpus/*.json
!/corpus/**/*.json

# Phase 8 clean-up: local kraken / tesstrain artifacts (regenerable, large)
dev/venv-grabar/
dev/kraken_review/data/
dev/segmented_lines/
dev/extracted_lines/
# Kraken review decisions are human-verified ground truth; negate the global *.json rule.
!/dev/kraken_review/reviews/*.json
# Phase 8 line-seg survey: venvs, vendored code and overlays are local; per-tool geometry
# and human reviews are committed (reviews reference geometry line ids).
dev/lineseg_survey/.venv-*/
dev/lineseg_survey/vendor/
dev/lineseg_survey/overlays/
# Candidate tools: commit only the 12 survey-sample pages (the reviews reference them);
# their full runs are regenerable inputs. The Phase 9 baseline is committed in full.
!/dev/lineseg_survey/*/data/page_453/segmentation.json
!/dev/lineseg_survey/*/data/page_457/segmentation.json
!/dev/lineseg_survey/*/data/page_488/segmentation.json
!/dev/lineseg_survey/*/data/page_519/segmentation.json
!/dev/lineseg_survey/*/data/page_530/segmentation.json
!/dev/lineseg_survey/*/data/page_557/segmentation.json
!/dev/lineseg_survey/*/data/page_564/segmentation.json
!/dev/lineseg_survey/*/data/page_575/segmentation.json
!/dev/lineseg_survey/*/data/page_593/segmentation.json
!/dev/lineseg_survey/*/data/page_610/segmentation.json
!/dev/lineseg_survey/*/data/page_641/segmentation.json
!/dev/lineseg_survey/*/data/page_642/segmentation.json
!/dev/lineseg_survey/paddle-filled/data/*/segmentation.json
!/dev/lineseg_survey/*/reviews/*.json
